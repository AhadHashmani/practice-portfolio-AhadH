<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ahad Hashmani - Portfolio</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- Header Section -->
  <header>
    <h1>Ahad Hashmani</h1>
    <p class="tagline">Aspiring Developer | Tech Enthusiast</p>
  </header>

  <main>
    <!-- About Me Section -->
    <section id="about">
      <h2>About Me</h2>
      <p>
        Hello! My name is Ahad Hashmani. I am learning web development, focusing on HTML, CSS, and modern web layout practices. I enjoy building structured web applications and solving problems through clean, efficient code.
      </p>
    </section>

    <!-- Skills Table Section -->
    <section id="skills">
      <h2>Skills & Experience</h2>
      <table>
        <thead>
          <tr>
            <th>Skill / Tool</th>
            <th>Category</th>
            <th>Proficiency Level</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>HTML5</td>
            <td>Frontend Structure</td>
            <td>Intermediate</td>
          </tr>
          <tr>
            <td>CSS3</td>
            <td>Styling & Layout</td>
            <td>Intermediate</td>
          </tr>
          <tr>
            <td>JavaScript</td>
            <td>Programming</td>
            <td>Beginner</td>
          </tr>
          <tr>
            <td>Git & GitHub</td>
            <td>Version Control</td>
            <td>Beginner</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- Contact Form Section -->
    <section id="contact">
      <h2>Contact Me</h2>
      <form action="#" method="POST">
        <div class="form-group">
          <label for="name">Name:</label>
          <input type="text" id="name" name="name" placeholder="Your Full Name" required />
        </div>

        <div class="form-group">
          <label for="email">Email:</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required />
        </div>

        <div class="form-group">
          <label for="message">Message:</label>
          <textarea id="message" name="message" rows="5" placeholder="Type your message here..." required></textarea>
        </div>

        <button type="submit">Send Message</button>
      </form>
    </section>
  </main>

  <!-- Footer Section -->
  <footer>
    <p>&copy; 2026 Ahad Hashmani. All rights reserved.</p>
  </footer>

</body>
</html>